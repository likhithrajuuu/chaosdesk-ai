CHAOSDESK_MODEL=gpt-4.1-mini
CHAOSDESK_DATABASE=var/chaosdesk.db
CHAOSDESK_WORKERS=4
CHAOSDESK_MAX_PENDING=1000
CHAOSDESK_MODEL_REQUESTS_PER_MINUTE=60
CHAOSDESK_MODEL_REQUESTS_PER_DAY=10000
CHAOSDESK_RETENTION_DAYS=7
